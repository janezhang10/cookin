{
  "name": "cookin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env XDG_CONFIG_HOME=.wrangler/config wrangler d1 migrations apply cookin-local --local && next dev",
    "dev:next": "next dev",
    "build": "next build",
    "build:sites": "opennextjs-cloudflare build && node scripts/prepare-sites-build.mjs",
    "migrate": "npm run db:local:migrate",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "db:generate": "drizzle-kit generate",
    "db:local:migrate": "cross-env XDG_CONFIG_HOME=.wrangler/config wrangler d1 migrations apply DB --local",
    "cf-typegen": "cross-env XDG_CONFIG_HOME=.wrangler/config wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.116.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true,
    "workerd@1.20260730.1": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "11.1.0"
    },
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
