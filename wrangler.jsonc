{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cookin-recipes",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cookin-recipes-db",
			"database_id": "49e3ec3e-7ca4-47f4-973c-be6407923272",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "cookin-recipes-photos"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}